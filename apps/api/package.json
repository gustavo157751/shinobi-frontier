{
  "name": "@shinobi/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "prestart:dev": "npm run prisma:generate",
    "start:prod": "node dist/main.js",
    "build": "nest build",
    "prebuild": "npm run prisma:generate",
    "test": "node --test test/*.test.cjs",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma --name init",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/platform-socket.io": "^12.4.2",
    "@nestjs/websockets": "^12.4.2",
    "@prisma/client": "^6.2.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "typescript": "^5.7.2"
  }
}
